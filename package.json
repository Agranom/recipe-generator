{
  "name": "recipe-generator",
  "version": "1.0.0",
  "description": "NodeJS Service to generate recipes from the socials",
  "main": "index.ts",
  "scripts": {
    "prepare": "npx husky-init && husky install",
    "test": "jest --passWithNoTests --forceExit --detectOpenHandles",
    "test:watch": "jest --passWithNoTests --watch ",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "npx prettier src --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run prettier:fix && npm run lint:fix",
    "build": "tsc",
    "dev": "nodemon index.ts",
    "start": "env node ./dist/index.js --  RECIPE_GENERATOR",
    "predeploy": "npm run lint && npm run test && npm run build",
    "deploy": "npm run predeploy && gcloud run deploy recipe-generator --source=./ --platform managed --region us-west1 --no-allow-unauthenticated",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "nodemon": "^3.1.9",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@langchain/core": "^0.3.30",
    "@langchain/openai": "^0.3.17",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fluent-ffmpeg": "^2.1.3",
    "ig-downloader": "^1.1.4",
    "mongodb": "^6.8.0",
    "puppeteer": "^24.0.0",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "zod": "^3.24.1"
  },
  "lint-staged": {
    "*.{ts,js}": "npm run format"
  }
}
